# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (Replace with your secure MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zero-cineviv?retryWrites=true&w=majority

# JWT Configuration (Generate a strong 64-character secret in production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Optional - for nodemailer)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@zerobycineviv.com

# Admin Default Credentials (Used by seed script)
ADMIN_EMAIL=admin@zerobycineviv.com
ADMIN_PASSWORD=SetSecureAdminPasswordHere!

# Frontend URL for CORS Whitelisting (comma or || separated for multiple)
FRONTEND_URL=http://localhost:3000 || https://zerotushar.netlify.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
